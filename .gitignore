# Build artifacts
/bin/
dist/
chalkd.exe
*.test
*.out
coverage.*

# Go
vendor/

# Node (Playwright)
node_modules/
test-results/
playwright-report/
playwright/.cache/

# Local environment
.env
.env.local
*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Generated docs
/docs/_generated/

# Local data dirs (only relevant outside of containers)
/var/

# Backup files from in-place patch scripts
*.bak-*
*.pre-*

# esbuild transpile cache for the test runners
web/.test-build/
desktop/.test-build/

# Generated by tools/sound-bench.mjs from the template beside it
/tools/sound-bench.html

.gov*-backup*/

# Applier rollback backups (never commit these)
.*-backup-*/
.*-backup-[0-9]*/
.backup*/
.chalk*-backup/
/chalkctl

.claude/
!.claude/
!.claude/skills/
# Throwaway UI probes (see CLAUDE.md). !.claude/skills/ above un-ignores this
# subtree, so without this rule every scratch probe shows up in git status.
.claude/skills/run-chalk/probes/

node

# Built binaries at the repo root. ANCHORED: a bare `chalkctl` also matched the
# internal/chalkctl/ directory, silently ignoring every new file added there
# (already-tracked files were unaffected, which is what hid it). /bin/ above
# covers the copies under bin/.
/chalkctl

