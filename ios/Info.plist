<plist version="1.0">
<dict>
	<key>ChalkKeychainGroup</key>
	<string>$(AppIdentifierPrefix)at.73c.chalk.shared</string>
	<key>ChalkLegacyKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>UIBackgroundModes</key>
