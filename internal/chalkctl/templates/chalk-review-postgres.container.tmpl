# chalk -- Postgres {{ .PostgresTag }} of the review instance (generated by
# chalkctl review). It is only on the chalk-review network.
[Unit]
Description=chalk review Postgres
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=postgres-review
Image=docker.io/library/postgres:{{ .PostgresTag }}
Network=chalk-review.network
Volume=chalk-review-pgdata.volume:/var/lib/postgresql
EnvironmentFile=/etc/chalk/review.env
Environment=POSTGRES_DB=chalk
Environment=POSTGRES_USER=chalk
HealthCmd=pg_isready -U chalk -d chalk
HealthInterval=5s
HealthTimeout=3s
HealthRetries=10

[Service]
Restart=always
{{- if .Up }}

[Install]
WantedBy=default.target
{{- end }}
