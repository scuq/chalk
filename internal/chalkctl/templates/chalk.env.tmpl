# chalk -- secrets + host config (generated by chalkctl init). chmod 600.
# All values are LITERAL. systemd/Quadlet expands Environment= lines BEFORE
# EnvironmentFile= loads, so NOTHING here may be a dollar-brace cross-reference and
# NO unit may compose a value from another env var -- each container reads its
# values straight from this file.

# --- database ---
CHALK_PG_PASSWORD={{ .PGPassword }}
POSTGRES_PASSWORD={{ .PGPassword }}

# 80-1: chalkd runs day-to-day as chalk_app (non-superuser member of the owner
# role); connections serving an ephemeral guest use chalk_guest, fenced by row
# level security. chalkctl creates both roles in Postgres (init/update/restore).
CHALK_PG_APP_PASSWORD={{ .PGAppPassword }}
CHALK_PG_GUEST_PASSWORD={{ .PGGuestPassword }}
CHALK_DB_URL=postgres://chalk_app:{{ .PGAppPassword }}@postgres:5432/chalk?sslmode=disable
CHALK_DB_URL_GUEST=postgres://chalk_guest:{{ .PGGuestPassword }}@postgres:5432/chalk?sslmode=disable

# --- WebAuthn / passkeys (RP ID MUST equal the domain; origins the https URL) ---
CHALK_RP_ID={{ .Domain }}
CHALK_RP_NAME=chalk
CHALK_RP_ORIGINS=https://{{ .Domain }}

# --- admin seed (first boot only; claim it with the token below) ---
CHALK_ADMIN_USERNAME={{ .AdminUsername }}
CHALK_ADMIN_EMAIL={{ .AdminEmail }}

# --- registration (bootstrap: let friends sign up; set false once everyone's in) ---
CHALK_OPEN_REGISTRATION={{ .OpenRegistration }}

# --- auth v2 (TOTP secrets AES-256-GCM at rest; 32 bytes, standard base64) ---
CHALK_TOTP_ENC_KEY={{ .TOTPEncKey }}

# --- server identity (phase 83; Ed25519 seed, 32 bytes, standard base64) ---
# Every client pins this server's identity at registration and refuses to
# talk to a server that answers with another key. Never regenerate it
# casually: `chalkctl serverkey show` prints the fingerprint to announce
# to users if you ever must rotate it (they re-pin from the wall screen).
CHALK_SERVER_ID_KEY={{ .ServerIDKey }}

# Keys the fake KDF params served for unknown usernames. Must be STABLE across
# restarts: chalkd generates a per-process one when this is unset, and decoys
# that change while real accounts' params don't are themselves the tell.
CHALK_AUTH_DECOY_KEY={{ .AuthDecoyKey }}

# --- proxy ---
# chalkd sits behind chalkctl's Caddy on a shared podman network, so the peer
# address is always the proxy. Trusting X-Forwarded-For from private peers is
# what lets per-IP rate limits and session records see the real client.
CHALK_TRUSTED_PROXY=private

# One-shot token authorizing the FIRST claim of the admin account, via
# https://<domain>/?admin_token=<this>. The operator sets the password +
# TOTP there. Dead the moment the account is claimed; safe to leave in place.
CHALK_ADMIN_BOOTSTRAP_TOKEN={{ .AdminBootstrapToken }}
{{- if .VoiceEnabled }}

# --- voice ---
CHALK_TURN_SECRET={{ .TurnSecret }}
{{- if gt .VoiceMaxParticipants 0 }}
CHALK_VOICE_MAX_PARTICIPANTS={{ .VoiceMaxParticipants }}
{{- end }}
{{- end }}
{{- if gt .AttachMaxBytes 0 }}

# --- attachments ---
CHALK_ATTACH_MAX_BYTES={{ .AttachMaxBytes }}
{{- end }}
{{- if gt .ThreadActiveWindowHours 0 }}

# --- threads (how far back a reply counts as "active" in the thread inbox;
# does NOT affect unread -- an unread thread you took part in is always shown) ---
CHALK_THREAD_ACTIVE_WINDOW_HOURS={{ .ThreadActiveWindowHours }}
{{- end }}
{{- if .GiphyAPIKey }}

# --- giphy ---
CHALK_GIPHY_API_KEY={{ .GiphyAPIKey }}
{{- end }}
{{- if or (not .LinkPreviewEnabled) .LinkPreviewDomains }}

# --- link previews (sender-side fetch; docs/phases/PHASE-57-LINKPREVIEW.md) ---
{{- if not .LinkPreviewEnabled }}
CHALK_LINKPREVIEW_ENABLED=false
{{- end }}
{{- if .LinkPreviewDomains }}
CHALK_LINKPREVIEW_DOMAINS={{ .LinkPreviewDomains }}
{{- end }}
{{- end }}

# --- signed channel-key wraps (docs/phases/PHASE-82-SIGNEDWRAP.md) ---
# false = legacy unsigned wraps still accepted (the migration window). Flip to
# true once every active channel has been re-opened on a current build (the
# self-healing sweep re-signs wraps as channels get used); after that, unsigned
# wraps are refused server-side and client-side.
CHALK_WRAP_SIG_REQUIRED={{ .WrapSigRequired }}

# --- ephemeral voice channels (guest magic links; docs/phases/PHASE-80-EPHEMERAL.md) ---
# Written either way since 81-3: the server default is off, so leaving this
# out would silently disable guest rooms rather than keep them as configured.
CHALK_EPHEMERAL_ENABLED={{ .EphemeralEnabled }}
{{- if gt .EphemeralMaxTTLHours 0 }}
CHALK_EPHEMERAL_MAX_TTL_HOURS={{ .EphemeralMaxTTLHours }}
{{- end }}
{{- if gt .EphemeralInviteHours 0 }}
CHALK_EPHEMERAL_INVITE_MAX_TTL_HOURS={{ .EphemeralInviteHours }}
{{- end }}
{{- if gt .EphemeralMaxGuests 0 }}
CHALK_EPHEMERAL_MAX_GUESTS={{ .EphemeralMaxGuests }}
{{- end }}

# --- operational logging (phase 85) ---
# Security events: TOTP lockouts, rate-limit denials, failed and successful
# logins, attempts against blocked accounts. Rare by nature and throttled per
# address on top, so this stays on.
CHALK_OPLOG_SECURITY=true
# Connection snapshot: every N (e.g. "5m") log who is online, from which
# address, with their round-trip time. Empty = off, and that default is
# deliberate -- chalk encrypts what people say, but a standing record of who
# was connected when and from where is metadata that encryption does not
# cover, sitting in a plain log file. Turn it on if you want it.
CHALK_OPLOG_SNAPSHOT_INTERVAL=0
# Log any HTTP request slower than this. Costs a clock read per request and
# prints nothing on a healthy server. 0 disables it.
CHALK_OPLOG_SLOW_REQUEST=2s
