# chalk -- chalkd of the review instance (generated by chalkctl review). It
# runs the image of production chalkd, and `chalkctl update` repins both.
#
#   image  : {{ .Image }}:{{ .Version }}
#   digest : {{ .Digest }}
[Unit]
Description=chalk review chalkd
Wants=network-online.target
After=network-online.target chalk-review-postgres.service
Requires=chalk-review-postgres.service

[Container]
ContainerName=chalkd-review
Image={{ .Image }}@{{ .Digest }}
Network=chalk-review.network
Volume=chalk-review-blobs.volume:/var/lib/chalk/blobs
EnvironmentFile=/etc/chalk/review.env
Environment=CHALK_LISTEN=:8443
Environment=CHALK_TLS_MODE=off
Environment=CHALK_LOG_FORMAT=json
Environment=CHALK_INSTANCE_ID=review-1
Environment=CHALK_VOICE_ENABLED={{ .VoiceEnabled }}
{{- if .VoiceEnabled }}
# The coturn of production. review.env has the same CHALK_TURN_SECRET.
Environment=CHALK_TURN_URLS=turn:{{ .TurnDomain }}:3478,turn:{{ .TurnDomain }}:3478?transport=tcp
{{- end }}

[Service]
Restart=always
{{- if .Up }}

[Install]
WantedBy=default.target
{{- end }}
