# chalk -- coturn media relay (generated by chalkctl). Host networking; alpine
# image.
#
# EVERY setting is an Exec argument. This unit used to mount a rendered
# turnserver.conf and pass it with -c, but the file was silently ignored and
# coturn ran on its defaults -- a second source of truth that loses without
# saying so costs hours of debugging. `systemctl cat chalk-coturn` now shows
# the entire configuration.
#
# --flag=value form throughout, NEVER `--flag value`: one missing space in the
# space-separated form (`--realm chalk--verbose`) parses as a single argument,
# so the realm silently becomes "chalk--verbose" and --verbose never applies.
#
# The public address is pinned on all three of listening/relay/external rather
# than left to the image's DETECT_EXTERNAL_IP / DETECT_RELAY_IP helpers, which
# guess and never report what they guessed. IPv4 only.
#
# LOGGING is on the CLI as well (-n --log-file=stdout): coturn's file logger
# otherwise swallows output into /var/tmp/turn_*.log and `podman logs coturn`
# stays empty (coturn issues #507/#1528). -n disables the config-file log
# redirection so stdout logging reaches the container stdout.
#
# The verbose block adds the two options that make a failing allocation
# diagnosable: --include-reason-string puts the actual reason in the STUN error
# response instead of the bare phrase, and --log-binding re-enables binding
# logging, which verbose mode suppresses by default.
[Unit]
Description=chalk coturn
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=coturn
Image=docker.io/coturn/coturn:{{ .CoturnTag }}
Network=host
Exec=-n --log-file=stdout --simple-log --new-log-timestamp --listening-port=3478 --min-port={{ .TurnMinPort }} --max-port={{ .TurnMaxPort }} --realm=chalk --listening-ip={{ .PublicIP }} --relay-ip={{ .PublicIP }} --external-ip={{ .PublicIP }} --use-auth-secret --static-auth-secret={{ .TurnSecret }} --fingerprint --no-cli --no-tls --no-dtls{{ if .TurnVerbose }} --verbose --include-reason-string --log-binding{{ end }}

[Service]
Restart=always

[Install]
WantedBy=default.target
